# Copy to runtime/.env (gitignored). serve.mjs and topic.create.mjs load this file.
# Leave the Hedera block commented to keep POST /v1 free.

PORT=11435

# Bearer for curl / OpenAI clients. Blank → serve prints a random key at boot.
# OPENAI_API_KEY=

# --- Hedera testnet (paid /v1) ---
# Setting HEDERA_ACCOUNT_ID turns on HTTP 402 via Blocky402. /market posting stays free.
# Portal: https://portal.hedera.com  ·  topic: node topic.create.mjs
# HEDERA_ACCOUNT_ID=0.0.x
# HEDERA_PRIVATE_KEY=
# HCS_TOPIC_ID=0.0.x
# X402_PRICE_HBAR=0.001
# HOST_CUT_BPS=1000
# X402_FACILITATOR=https://api.testnet.blocky402.com
# HEDERA_NETWORK=hedera:testnet

# --- ENSv2 (on when Hedera is on) ---
# Host name from /onboard must resolve text key "hedera" = HEDERA_ACCOUNT_ID or paid /v1 is 403.
# Register on https://app.ens.dev/  (not sepolia.app.ens.domains).
# ENS_PARENT=trustedswarm.eth
# ENS_RPC=https://ethereum-sepolia-rpc.publicnode.com

# --- Bazantic ---
# No extra env. After serve is up: GET /openapi.json and paste runtime/bazantic-recipe.md
# on https://bazantic.com as the Recipe. Gateway endpoint is this process (or a tunnel).
